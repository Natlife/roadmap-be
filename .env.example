# ============================================================================
# Hoc Meo Node Backend — environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================================

# App
NODE_ENV=development            # development | production
PORT=5001
CORS_ORIGIN=*                   # comma-separated origins in prod, e.g. https://admin.site.com,https://app.site.com
BODY_LIMIT=50mb

# Database (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=1234                    # DB_PASSWORD is also accepted
DB_NAME=hocmeo
DB_POOL_LIMIT=20
DB_TIMEZONE=+07:00

# Auth — MUST be set in production (unset = public default key = insecure)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Seeding
ENABLE_DEMO_ACCOUNTS=true       # set false in prod once real accounts exist
ADMIN_SEED_PASSWORD=123456      # password for the seeded admin/user accounts
ENABLE_CANVA_SEED=false         # set true to import the Canva demo topic once
